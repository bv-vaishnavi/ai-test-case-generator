PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/test-case-generator
# Generate a random secret of at least 32 characters. Never commit the real value.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
GEMINI_API_KEY=
# Set this to a model available to your Google AI account.
GEMINI_MODEL=gemini-3.6-flash
# Used automatically when the primary model is unavailable or out of quota.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Use local for development. Files are written below LOCAL_UPLOAD_DIR.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads

# Switch STORAGE_DRIVER to s3 after AWS activation.
AWS_REGION=us-east-1
S3_BUCKET=
# Prefer an IAM role in production. The SDK uses the standard AWS credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Set only when deployed behind one trusted reverse proxy.
TRUST_PROXY=0
